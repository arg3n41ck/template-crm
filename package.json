{
  "name": "ruflo-template-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "preinstall": "node ./scripts/check.js",
    "dev": "vite",
    "build": "tsc -b &&  vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:type && pnpm lint:eslint && pnpm lint:prettier",
    "lint:prettier": "prettier --check .",
    "prettier": "prettier --write .",
    "lint:eslint": " eslint .",
    "lint:type": "tsc --noEmit",
    "eslint:fix": "eslint --fix",
    "prepare:prod": "pnpm run prettier && pnpm run lint && pnpm run build && pnpm test:vitest",
    "jscpd": "jscpd ./src",
    "storybook": "storybook dev -p 6006 -c ./src/shared/config/storybook",
    "build:storybook": "storybook build -c ./src/shared/config/storybook",
    "test:vitest": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:report": "pnpm dlx serve tests-results -l 8000 -s -n -C",
    "generate:api": "openapi-codegen generate api && prettier --write src/shared/services/api/generated",
    "verify": "pnpm lint && pnpm test:vitest && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-router": "^1.131.30",
    "@tanstack/react-router-devtools": "^1.131.30",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@openapi-codegen/cli": "^3.1.0",
    "@openapi-codegen/typescript": "^11.1.0",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/addons": "^7.6.17",
    "@storybook/blocks": "^7.6.17",
    "@storybook/react": "^7.6.17",
    "@storybook/react-vite": "^7.6.17",
    "@storybook/test": "^7.6.17",
    "@storybook/theming": "^8.3.6",
    "@tailwindcss/vite": "^4.0.7",
    "@tanstack/router-plugin": "^1.131.30",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.11.24",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/coverage-istanbul": "^2.1.3",
    "@vitest/ui": "^2.1.3",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "happy-dom": "^15.7.4",
    "jscpd": "^4.0.5",
    "prettier": "3.5.3",
    "storybook": "^8.3.6",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^2.1.3"
  },
  "packageManager": "pnpm@11.21.0"
}
